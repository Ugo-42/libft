#include <stdio.h>
#include "includes/libft.h"
#include <stdlib.h>

void	print_flexistr(const char *label, t_flexistr *fs)
{
	printf("== %s ==\n", label);
	if (!fs)
	{
		printf("NULL flexistr pointer\n");
		return;
	}
	printf("string: \"%s\"\n", fs->string ? fs->string : "(null)");
	printf("len: %zu\n", fs->len);
	printf("size: %zu\n", fs->size);
	printf("last_append_len: %zu\n", fs->last_append_len);
	printf("last_remove_len: %zu\n", fs->last_remove_len);
	printf("errno: %d\n", fs->errno);
	printf("--------------------------\n");
}

int	main(void)
{
	t_flexistr fs;

	// INIT
	if (fs_init(&fs, 8) != 0)
		return (fprintf(stderr, "fs_init failed\n"), 1);
	print_flexistr("After init", &fs);

	// APPEND basic string
	fs_append(&fs, "Hello", false);
	print_flexistr("After append 'Hello'", &fs);

	// APPEND_CHAR
	fs_append_char(&fs, ' ');
	print_flexistr("After append_char ' '", &fs);

	// APPEND NB (decimal)
	fs_append_nb(&fs, 42, NULL);
	print_flexistr("After append_nb 42 (base 10)", &fs);

	// APPEND NB (hex)
	fs_append(&fs, " 0x", false);
	fs_append_nb(&fs, 255, "0123456789abcdef");
	print_flexistr("After append_nb 255 (hex)", &fs);

	// APPEND_N
	fs_n_append(&fs, " TruncatedHere!", 5);
	print_flexistr("After n_append \" TruncatedHere!\" (5)", &fs);

	// REMOVE from middle
	fs_remove(&fs, 5, 9);
	print_flexistr("After remove [5, 9]", &fs);

	// REMOVE from start
	fs_remove(&fs, 0, 0);
	print_flexistr("After remove [0, 0]", &fs);

	// REMOVE from end
	fs_remove(&fs, fs.len - 1, fs.len - 1);
	print_flexistr("After remove [fs.len - 1, fs.len - 1]", &fs);

	// REMOVE many 
	fs_remove(&fs, 2, fs.len - 3);
	print_flexistr("After remove [2, fs.len - 3]", &fs);

	// REMOVE with invalid range (should be no-op)
	fs_remove(&fs, -100, -105);
	print_flexistr("After remove [-100, -105] (invalid)", &fs);

	// REMOVE with invalid range (should be no-op)
	fs_remove(&fs, -109, -105);
	print_flexistr("After remove [-109, -105] (invalid)", &fs);

	// REMOVE with invalid range (should be no-op)
	fs_remove(&fs, -109, 1);
	print_flexistr("After remove [-109, 1] ", &fs);

	// REMOVE with invalid range (should be no-op)
	fs_remove(&fs, 3, 105);
	print_flexistr("After remove [3, 105] (invalid)", &fs);

	// APPEND NULL (error)
	fs_append(&fs, NULL, false);
	print_flexistr("After append NULL (error)", &fs);

	// APPEND NULL (error)
	fs_add(&fs, "prefix", 0);
	print_flexistr("After add prefix ", &fs);

	// APPEND NULL (error)
	fs_add(&fs, "suffix", 100);
	print_flexistr("After add suffix ", &fs);

	// APPEND NULL (error)
	fs_add(&fs, "THREE", 3);
	print_flexistr("After add to 3 ", &fs);

	// APPEND NULL (error)
	fs_add(&fs, "END", fs.len - 1);
	print_flexistr("After add to end ", &fs);

	// FINALIZE (detach string)
	char *final = fs_finalize(&fs);
	printf("== After finalize ==\n");
	printf("finalized string: \"%s\"\n", final ? final : "(null)");
	print_flexistr("After finalize (struct should be reset)", &fs);
	free(final);

	return (0);
}

